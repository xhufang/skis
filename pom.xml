    <module>skis-dialect-postgresql</module>
    <module>skis-dialect-mysql</module>
    <module>skis-dialect-h2</module>
    <module>skis-dialect-sqlserver</module>
    <module>skis-dialect-oracle</module>
    <module>skis-dialect-db2</module>

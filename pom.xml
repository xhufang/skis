    <module>skis-dialect-api</module>
    <module>skis-dialect-support</module>
    <module>skis-mapping</module>
    <module>skis-jdbc</module>
    <module>skis-query</module>
    <module>skis-mutation</module>
    <module>skis-runtime</module>

    <module>skis-dialect-postgresql</module>
    <module>skis-dialect-h2</module>

    <module>skis-spring</module>

    <module>skis-test-support</module>
    <module>skis-test-model</module>
    <module>skis-benchmark</module>
    <module>skis-examples</module>
    <!-- Architecture contracts require every production, fixture and example output. -->
    <module>skis-integration-tests</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.deploy.skip>false</maven.deploy.skip>

    <spring-boot.version>4.1.0</spring-boot.version>
    <jspecify.version>1.0.0</jspecify.version>
    <slf4j.version>2.0.20</slf4j.version>
    <error-prone.version>2.50.0</error-prone.version>
    <nullaway.version>0.14.2</nullaway.version>
    <!-- Late evaluation lets JaCoCo supply its agent without losing profile JVM options. -->
    <argLine></argLine>
    <skis.coverage.unitArgLine></skis.coverage.unitArgLine>
    <skis.coverage.pgArgLine></skis.coverage.pgArgLine>
    <skis.staticAnalysis.jvmArgs></skis.staticAnalysis.jvmArgs>
    <jacoco.version>0.8.15</jacoco.version>
    <testcontainers.version>2.0.5</testcontainers.version>

    <maven-compiler-plugin.version>3.14.1</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.4</maven-surefire-plugin.version>
    <maven-enforcer-plugin.version>3.6.2</maven-enforcer-plugin.version>
    <license-maven-plugin.version>2.7.1</license-maven-plugin.version>
    <cyclonedx-maven-plugin.version>2.9.3</cyclonedx-maven-plugin.version>
    <central-publishing-maven-plugin.version>0.11.0</central-publishing-maven-plugin.version>
    <maven-javadoc-plugin.version>3.12.0</maven-javadoc-plugin.version>
    <maven-source-plugin.version>3.4.0</maven-source-plugin.version>
    <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
    <maven-release-plugin.version>3.1.1</maven-release-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.jspecify</groupId>
        <artifactId>jspecify</artifactId>
        <version>${jspecify.version}</version>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-postgresql</artifactId>
        <version>${testcontainers.version}</version>
      </dependency>

      <dependency>
        <groupId>io.github.xhufang</groupId>
        <artifactId>skis-annotations</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.xhufang</groupId>
        <artifactId>skis-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.xhufang</groupId>
        <artifactId>skis-metadata</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.xhufang</groupId>
        <artifactId>skis-processor</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.xhufang</groupId>
        <artifactId>skis-sql-ast</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.xhufang</groupId>
        <artifactId>skis-dialect-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.xhufang</groupId>
        <artifactId>skis-dialect-support</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.xhufang</groupId>
        <artifactId>skis-mapping</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.xhufang</groupId>
        <artifactId>skis-jdbc</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.xhufang</groupId>
        <artifactId>skis-query</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.xhufang</groupId>
        <artifactId>skis-mutation</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.xhufang</groupId>
        <artifactId>skis-runtime</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>io.github.xhufang</groupId>
        <artifactId>skis-dialect-postgresql</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.xhufang</groupId>
        <artifactId>skis-dialect-h2</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>io.github.xhufang</groupId>
        <artifactId>skis-spring</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>io.github.xhufang</groupId>
        <artifactId>skis-test-support</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.xhufang</groupId>
        <artifactId>skis-test-model</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
          <configuration>
            <excludedGroups>postgres-contract</excludedGroups>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-failsafe-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>license-maven-plugin</artifactId>
          <version>${license-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.cyclonedx</groupId>
          <artifactId>cyclonedx-maven-plugin</artifactId>
          <version>${cyclonedx-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.sonatype.central</groupId>
          <artifactId>central-publishing-maven-plugin</artifactId>
          <version>${central-publishing-maven-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-javadoc-plugin</artifactId>
          <version>${maven-javadoc-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-source-plugin</artifactId>
          <version>${maven-source-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-gpg-plugin</artifactId>
          <version>${maven-gpg-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-release-plugin</artifactId>
          <version>${maven-release-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-baseline</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9,)</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>postgres-contracts</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <includes><include>**/*Test.java</include></includes>
              <groups>postgres-contract</groups>
              <forkCount>1</forkCount>
              <reuseForks>true</reuseForks>
              <systemPropertyVariables>
                <junit.jupiter.execution.parallel.enabled>false</junit.jupiter.execution.parallel.enabled>
                <junit.jupiter.extensions.store.close.autocloseable.enabled>true</junit.jupiter.extensions.store.close.autocloseable.enabled>
              </systemPropertyVariables>
            </configuration>
            <executions>
              <execution>
                <id>postgres-contracts</id>
                <goals><goal>integration-test</goal><goal>verify</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>static-analysis</id>
      <properties>
        <skis.staticAnalysis.jvmArgs>--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED --add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED --add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED --add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED --add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED --add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED --add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED --add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED --add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED --add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</skis.staticAnalysis.jvmArgs>
        <skis.staticAnalysis.checks>-Xplugin:ErrorProne -Xep:NullAway:ERROR -Xep:RequireExplicitNullMarking:ERROR -Xep:JSpecifyUnrecognizedAnnotationLocation:ERROR -XepOpt:NullAway:OnlyNullMarked=true -XepOpt:NullAway:JSpecifyMode=true -XepOpt:NullAway:HandleWildcardGenerics=true -XepOpt:NullAway:JSpecifyJDKModels=true -XepOpt:NullAway:WarnOnGenericInferenceFailure=true</skis.staticAnalysis.checks>
      </properties>
      <!-- Only the dedicated embedded-javac tests need tools on their test classpath. -->
      <dependencies>
        <dependency>
          <groupId>com.google.errorprone</groupId>
          <artifactId>error_prone_core</artifactId>
          <version>${error-prone.version}</version>
          <scope>test</scope>
        </dependency>
        <dependency>
          <groupId>com.uber.nullaway</groupId>
          <artifactId>nullaway</artifactId>
          <version>${nullaway.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <executions>
              <execution>
                <id>enforce-static-analysis-jdk</id>
                <goals><goal>enforce</goal></goals>
                <configuration>
                  <rules>
                    <requireJavaVersion>
                      <version>[21.0.8,22),[25,26)</version>
                    </requireJavaVersion>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
              <annotationProcessorPaths>
                <path>
                  <groupId>com.google.errorprone</groupId>
                  <artifactId>error_prone_core</artifactId>
                  <version>${error-prone.version}</version>
                </path>
                <path>
                  <groupId>com.uber.nullaway</groupId>
                  <artifactId>nullaway</artifactId>
                  <version>${nullaway.version}</version>
                </path>
              </annotationProcessorPaths>
            </configuration>
            <executions>
              <execution>
                <id>default-compile</id>
                <configuration>
                  <fork>true</fork>
                  <compilerArgs>
                    <arg>-XDcompilePolicy=simple</arg>
                    <arg>--should-stop=ifError=FLOW</arg>
                    <arg>-XDaddTypeAnnotationsToSymbol=true</arg>
                    <arg>${skis.staticAnalysis.checks}</arg>
                    <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</arg>
                    <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</arg>
                    <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</arg>
                    <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</arg>
                    <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</arg>
                    <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
                    <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
                    <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</arg>
                    <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
                    <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
                  </compilerArgs>
                </configuration>
              </execution>
              <!-- Intentional null/nominal-type failures in ordinary tests use plain javac. -->
              <execution>
                <id>default-testCompile</id>
                <configuration>
                  <compilerArgs combine.self="override" />
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <!--suppress UnresolvedMavenProperty -->
              <argLine>@{argLine} @{skis.coverage.unitArgLine} ${skis.staticAnalysis.jvmArgs}</argLine>
              <systemPropertyVariables>
                <skis.staticAnalysis>true</skis.staticAnalysis>
                <skis.staticAnalysis.checks>${skis.staticAnalysis.checks}</skis.staticAnalysis.checks>
                <skis.errorProne.version>${error-prone.version}</skis.errorProne.version>
                <skis.nullaway.version>${nullaway.version}</skis.nullaway.version>
              </systemPropertyVariables>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <!--suppress UnresolvedMavenProperty -->
              <argLine>@{argLine} @{skis.coverage.pgArgLine} ${skis.staticAnalysis.jvmArgs}</argLine>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>coverage</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <executions>
              <execution>
                <id>enforce-coverage-toolchain</id>
                <goals><goal>enforce</goal></goals>
                <configuration>
                  <rules>
                    <requireJavaVersion><version>[21,22)</version></requireJavaVersion>
                    <requireProperty>
                      <property>skis.coverage.commit</property>
                      <regex>[0-9a-f]{40}</regex>
                    </requireProperty>
                    <requireProperty>
                      <property>maven.compiler.release</property>
                      <regex>21</regex>
                    </requireProperty>
                    <requireProperty>
                      <property>jacoco.version</property>
                      <regex>0[.]8[.]15</regex>
                    </requireProperty>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <version>${jacoco.version}</version>
            <configuration>
              <append>true</append>
              <includes><include>io.skis.*</include></includes>
            </configuration>
            <executions>
              <execution>
                <id>coverage-unit-agent</id>
                <goals><goal>prepare-agent</goal></goals>
                <configuration>
                  <propertyName>skis.coverage.unitArgLine</propertyName>
                  <!--suppress UnresolvedMavenProperty -->
                  <destFile>${project.build.directory}/jacoco/unit-${surefire.forkNumber}.exec</destFile>
                  <!--suppress UnresolvedMavenProperty -->
                  <sessionId>${skis.coverage.commit}:${project.artifactId}:unit-${surefire.forkNumber}</sessionId>
                </configuration>
              </execution>
              <execution>
                <id>coverage-postgres-agent</id>
                <goals><goal>prepare-agent-integration</goal></goals>
                <configuration>
                  <propertyName>skis.coverage.pgArgLine</propertyName>
                  <!--suppress UnresolvedMavenProperty -->
                  <destFile>${project.build.directory}/jacoco/postgres-${surefire.forkNumber}.exec</destFile>
                  <!--suppress UnresolvedMavenProperty -->
                  <sessionId>${skis.coverage.commit}:${project.artifactId}:postgres-${surefire.forkNumber}</sessionId>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <!--suppress UnresolvedMavenProperty -->
              <argLine>@{argLine} @{skis.coverage.unitArgLine} ${skis.staticAnalysis.jvmArgs}</argLine>
              <forkCount>1</forkCount>
              <reuseForks>true</reuseForks>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <!--suppress UnresolvedMavenProperty -->
              <argLine>@{argLine} @{skis.coverage.pgArgLine} ${skis.staticAnalysis.jvmArgs}</argLine>
              <forkCount>1</forkCount>
              <reuseForks>true</reuseForks>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>3.8.1</version>
            <inherited>false</inherited>
            <executions>
              <execution>
                <id>coverage-cli</id>
                <phase>initialize</phase>
                <goals><goal>copy</goal></goals>
                <configuration>
                  <artifactItems>
                    <artifactItem>
                      <groupId>org.jacoco</groupId>
                      <artifactId>org.jacoco.cli</artifactId>
                      <version>${jacoco.version}</version>
                      <classifier>nodeps</classifier>
                      <destFileName>jacococli.jar</destFileName>
                    </artifactItem>
                  </artifactItems>
                  <outputDirectory>${project.build.directory}/coverage-tools</outputDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>compliance</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>license-maven-plugin</artifactId>
            <inherited>false</inherited>
            <executions>
              <execution>
                <id>check-third-party-licenses</id>
                <phase>verify</phase>
                <goals>
                  <goal>aggregate-add-third-party</goal>
                </goals>
                <configuration>
                  <excludedScopes>test,system</excludedScopes>
                  <failOnMissing>true</failOnMissing>
                  <includeOptional>true</includeOptional>
                  <includeTransitiveDependencies>true</includeTransitiveDependencies>
                  <outputDirectory>${project.build.directory}/generated-resources/licenses
                  </outputDirectory>
                  <thirdPartyFilename>THIRD-PARTY.txt</thirdPartyFilename>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.cyclonedx</groupId>
            <artifactId>cyclonedx-maven-plugin</artifactId>
            <inherited>false</inherited>
            <executions>
              <execution>
                <id>make-aggregate-sbom</id>
                <phase>verify</phase>
                <goals>
                  <goal>makeAggregateBom</goal>
                </goals>
                <configuration>
                  <projectType>library</projectType>
                  <schemaVersion>1.6</schemaVersion>
                  <includeBomSerialNumber>true</includeBomSerialNumber>
                  <includeTestScope>false</includeTestScope>
                  <outputFormat>all</outputFormat>
                  <outputDirectory>${project.build.directory}/sbom</outputDirectory>
                  <outputName>skis-${project.version}-bom</outputName>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <configuration>
              <skipSource>${maven.deploy.skip}</skipSource>
            </configuration>
            <executions>
              <execution>
                <id>attach-sources</id>
                <phase>package</phase>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <configuration>
              <excludePackageNames>*.internal</excludePackageNames>
              <skip>${maven.deploy.skip}</skip>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <phase>package</phase>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <configuration>
              <skip>${maven.deploy.skip}</skip>
            </configuration>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
              <waitUntil>validated</waitUntil>
              <ignorePublishedComponents>false</ignorePublishedComponents>
              <excludeArtifacts>
                skis-test-support,skis-test-model,skis-integration-tests,skis-benchmark,skis-examples,skis-example-h2
              </excludeArtifacts>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

      <dependency>
        <groupId>io.skis</groupId>
        <artifactId>skis-schema</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.skis</groupId>
        <artifactId>skis-codegen</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>io.skis</groupId>
        <artifactId>skis-spring</artifactId>

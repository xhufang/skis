  <profiles>
    <profile>
      <id>api-compatibility</id>
      <properties>
        <!-- 0.2.0 is the latest public API baseline; pull-request CI may override this
             with a locally built ref to validate the exact target branch. -->
        <api.previous.version>0.2.0</api.previous.version>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>com.github.siom79.japicmp</groupId>
            <artifactId>japicmp-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>check-public-api</id>
                <phase>verify</phase>
                <goals>
                  <goal>cmp</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <oldVersion>
                <dependency>
                  <groupId>${project.groupId}</groupId>
                  <artifactId>${project.artifactId}</artifactId>
                  <version>${api.previous.version}</version>
                  <type>jar</type>
                </dependency>
              </oldVersion>
              <newVersion>
                <file>
                  <path>${project.build.directory}/${project.artifactId}-${project.version}.jar
                  </path>
                </file>
              </newVersion>
              <parameter>
                <accessModifier>public</accessModifier>
                <onlyModified>true</onlyModified>
                <includeSynthetic>false</includeSynthetic>
                <ignoreMissingClasses>true</ignoreMissingClasses>
                <ignoreMissingOldVersion>true</ignoreMissingOldVersion>
                <skipPomModules>true</skipPomModules>
                <breakBuildOnBinaryIncompatibleModifications>true
                </breakBuildOnBinaryIncompatibleModifications>
                <breakBuildOnSourceIncompatibleModifications>true
                </breakBuildOnSourceIncompatibleModifications>
                <reportOnlyFilename>true</reportOnlyFilename>
                <!-- Exact 0.2.2/0.2.3 internal-line breaks approved by the development plan.
                     Keep this list at class/member granularity. -->
                <excludes>
                  <exclude>io.skis.query.EntitySelectQuery</exclude>
                  <exclude>io.skis.query.ProjectedSelectQuery</exclude>
                  <exclude>io.skis.query.QueryColumn</exclude>
                  <exclude>io.skis.query.QueryOperations#selectFrom(io.skis.query.QueryTable)</exclude>
                  <exclude>io.skis.query.QueryOperations#select(io.skis.query.QueryColumn)</exclude>
                  <exclude>io.skis.query.QueryOperations#select(io.skis.query.NonNullQueryColumn)</exclude>
                  <exclude>io.skis.query.QueryOperations#select(io.skis.query.NullableQueryColumn)</exclude>
                  <exclude>io.skis.query.QueryOperations#selectProjection(io.skis.query.QueryTable,java.lang.Class)</exclude>
                  <exclude>io.skis.query.SelectFromStep#from(io.skis.query.QueryTable)</exclude>
                  <exclude>io.skis.sql.ast.SqlExpression#sqlType()</exclude>
                  <exclude>io.skis.sql.ast.SqlExpression#nullability()</exclude>
                  <exclude>io.skis.sql.ast.SqlPredicate#sqlType()</exclude>
                </excludes>
                <excludeModules>
                  <excludeModule>skis-benchmark</excludeModule>
                  <excludeModule>skis-benchmark-.*</excludeModule>
                  <excludeModule>skis-integration-tests</excludeModule>
                  <excludeModule>skis-examples</excludeModule>
                  <excludeModule>skis-example-.*</excludeModule>
                  <excludeModule>skis-test-model</excludeModule>
                </excludeModules>
              </parameter>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>compliance</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>license-maven-plugin</artifactId>
            <inherited>false</inherited>
            <executions>
              <execution>
                <id>check-third-party-licenses</id>
                <phase>verify</phase>
                <goals>
                  <goal>aggregate-add-third-party</goal>
                </goals>
                <configuration>
                  <excludedScopes>test,system</excludedScopes>
                  <failOnMissing>true</failOnMissing>
                  <includeOptional>true</includeOptional>
                  <includeTransitiveDependencies>true</includeTransitiveDependencies>
                  <outputDirectory>${project.build.directory}/generated-resources/licenses
                  </outputDirectory>
                  <thirdPartyFilename>THIRD-PARTY.txt</thirdPartyFilename>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.cyclonedx</groupId>
            <artifactId>cyclonedx-maven-plugin</artifactId>
            <inherited>false</inherited>
            <executions>
              <execution>
                <id>make-aggregate-sbom</id>
                <phase>verify</phase>
                <goals>
                  <goal>makeAggregateBom</goal>
                </goals>
                <configuration>
                  <projectType>library</projectType>
                  <schemaVersion>1.6</schemaVersion>
                  <includeBomSerialNumber>true</includeBomSerialNumber>
                  <includeTestScope>false</includeTestScope>
                  <outputFormat>all</outputFormat>
                  <outputDirectory>${project.build.directory}/sbom</outputDirectory>
                  <outputName>skis-${project.version}-bom</outputName>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <configuration>
              <skipSource>${maven.deploy.skip}</skipSource>
            </configuration>
            <executions>
              <execution>
                <id>attach-sources</id>
                <phase>package</phase>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <configuration>
              <skip>${maven.deploy.skip}</skip>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <phase>package</phase>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <configuration>
              <skip>${maven.deploy.skip}</skip>
            </configuration>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
              <waitUntil>validated</waitUntil>
              <ignorePublishedComponents>false</ignorePublishedComponents>
              <excludeArtifacts>
                skis-optimizer,skis-graph,skis-dialect-mysql,skis-dialect-sqlserver,skis-dialect-oracle,skis-dialect-db2,skis-dialect-sqlite,skis-dialect-mariadb,skis-cache-api,skis-cache-caffeine,skis-cache-redis,skis-multitenancy,skis-data-permission,skis-datasource-routing,skis-encryption,skis-audit,skis-observability,skis-schema,skis-codegen,skis-spring-boot,skis-spring-boot-starter,skis-spring-boot-actuator,skis-spring-boot-starter-test,skis-test-support,skis-test-model,skis-integration-tests,skis-benchmark,skis-benchmark-jdbc,skis-benchmark-skis,skis-benchmark-jimmer,skis-benchmark-mybatis,skis-benchmark-mybaitisflex,skis-benchmark-mybatisplus,skis-benchmark-jooq,skis-benchmark-runner,skis-examples,skis-example-h2
              </excludeArtifacts>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

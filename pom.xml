        <artifactId>skis-jdbc</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.skis</groupId>
        <artifactId>skis-query</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.skis</groupId>
        <artifactId>skis-mutation</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.skis</groupId>
        <artifactId>skis-graph</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.skis</groupId>
        <artifactId>skis-runtime</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>io.skis</groupId>
        <artifactId>skis-dialect-postgresql</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.skis</groupId>
        <artifactId>skis-dialect-mysql</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.skis</groupId>
        <artifactId>skis-dialect-h2</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.skis</groupId>
        <artifactId>skis-dialect-sqlserver</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.skis</groupId>

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.xhufang</groupId>
    <artifactId>skis-parent</artifactId>
    <version>0.2.8-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>skis-query</artifactId>
  <name>skis-query</name>
  <description>Typed entity, scalar, generated projection, and explicit Join queries</description>
  <dependencies>
    <dependency>
      <groupId>io.github.xhufang</groupId>
      <artifactId>skis-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.xhufang</groupId>
      <artifactId>skis-metadata</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.xhufang</groupId>
      <artifactId>skis-mapping</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.xhufang</groupId>
      <artifactId>skis-sql-ast</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.xhufang</groupId>
      <artifactId>skis-dialect-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.xhufang</groupId>
      <artifactId>skis-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.xhufang</groupId>
      <artifactId>skis-dialect-support</artifactId>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-runtime-boundaries</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <excludes>
                    <exclude>*:*</exclude>
                    <exclude>org.mybatis*:*</exclude>
                    <exclude>com.baomidou:*</exclude>
                    <exclude>org.hibernate*:*</exclude>
                    <exclude>org.babyfish.jimmer:*</exclude>
                    <exclude>jakarta.persistence:*</exclude>
                    <exclude>javax.persistence:*</exclude>
                    <exclude>io.github.xhufang:skis-processor:*:*:compile</exclude>
                    <exclude>io.github.xhufang:skis-processor:*:*:runtime</exclude>
                    <exclude>ch.qos.logback:*</exclude>
                    <exclude>org.apache.logging.log4j:log4j-core</exclude>
                    <exclude>org.apache.logging.log4j:log4j-slf4j*</exclude>
                    <exclude>org.slf4j:slf4j-simple</exclude>
                    <exclude>org.slf4j:slf4j-jdk14</exclude>
                    <exclude>org.slf4j:slf4j-reload4j</exclude>
                    <exclude>org.slf4j:slf4j-log4j12</exclude>
                    <exclude>org.slf4j:slf4j-nop</exclude>
                    <exclude>org.slf4j:jul-to-slf4j</exclude>
                    <exclude>org.slf4j:jcl-over-slf4j</exclude>
                    <exclude>org.slf4j:log4j-over-slf4j</exclude>
                    <exclude>org.postgresql:*</exclude>
                    <exclude>com.h2database:*</exclude>
                    <exclude>com.mysql:*</exclude>
                    <exclude>mysql:*</exclude>
                    <exclude>org.mariadb.jdbc:*</exclude>
                    <exclude>com.microsoft.sqlserver:*</exclude>
                    <exclude>com.oracle.database.jdbc:*</exclude>
                    <exclude>org.xerial:sqlite-jdbc</exclude>
                    <exclude>com.ibm.db2:*</exclude>
                    <exclude>com.github.ben-manes.caffeine:*</exclude>
                    <exclude>redis.clients:*</exclude>
                    <exclude>io.lettuce:*</exclude>
                    <exclude>org.springframework:*</exclude>
                    <exclude>org.springframework.boot:*</exclude>
                  </excludes>
                  <includes>
                    <include>io.github.xhufang:skis-annotations</include>
                    <include>io.github.xhufang:skis-core</include>
                    <include>io.github.xhufang:skis-dialect-api</include>
                    <include>io.github.xhufang:skis-dialect-support</include>
                    <include>io.github.xhufang:skis-jdbc</include>
                    <include>io.github.xhufang:skis-mapping</include>
                    <include>io.github.xhufang:skis-metadata</include>
                    <include>io.github.xhufang:skis-sql-ast</include>
                    <include>org.jspecify:jspecify</include>
                    <include>org.slf4j:slf4j-api</include>
                    <include>*:*:*:*:test</include>
                  </includes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
